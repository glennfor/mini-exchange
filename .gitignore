# Project-specific
# Anchored to the repository root: an unanchored `data/` also matches
# replay/tests/data/, which is a committed test fixture. That mistake meant
# the LOBSTER validation fixture was missing from a fresh clone and its test
# failed there while passing locally -- found by actually cloning.
/data/
*.itch
*.itch.gz
*.csv.gz
bench/results/raw/
viz/ui/node_modules/
viz/ui/dist/
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
perf.data*
*.svg.tmp

# libFuzzer writes discovered inputs into the corpus directory; only the
# hand-made seeds (*.bin) are committed.
feed/fuzz/corpus/*
!feed/fuzz/corpus/*.bin
!feed/fuzz/corpus/README.md
crash-*
leak-*
timeout-*

# Market data is downloaded by scripts/fetch_data.sh, never committed.
/data/

# Only the gzipped sample recording is committed; regenerate the plain one
# with `python -m viz.server.record_frames`.
viz/server/sample_frames.jsonl

# UI build output and dependencies
viz/ui/dist/
viz/ui/node_modules/
viz/ui/*.tsbuildinfo
