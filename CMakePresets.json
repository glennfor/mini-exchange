{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "dev -- unoptimised, all warnings, tests on",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-O0 -g",
        "MINIEX_BUILD_TESTS": "ON",
        "MINIEX_BUILD_TOOLS": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "asan -- AddressSanitizer + UndefinedBehaviorSanitizer",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-O1 -g -fno-omit-frame-pointer -fsanitize=address,undefined -fno-sanitize-recover=undefined",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "MINIEX_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "ubsan",
      "inherits": "base",
      "displayName": "ubsan -- UndefinedBehaviorSanitizer only (works on macOS)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-O1 -g -fno-omit-frame-pointer -fsanitize=undefined -fno-sanitize-recover=undefined",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=undefined",
        "MINIEX_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "tsan -- ThreadSanitizer, ring/tap tests only",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-O1 -g -fno-omit-frame-pointer -fsanitize=thread",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "MINIEX_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "release -- -O3, native, LTO, benchmarks on",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-O3",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
        "MINIEX_NATIVE": "ON",
        "MINIEX_BUILD_BENCH": "ON",
        "MINIEX_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "release-tap",
      "inherits": "release",
      "displayName": "release-tap -- release plus the observability tap",
      "cacheVariables": {
        "MINIEX_TAP": "ON"
      }
    },
    {
      "name": "release-portable",
      "inherits": "base",
      "displayName": "release-portable -- no -march=native, for reproducibility checks",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS": "-O3 -mtune=generic",
        "MINIEX_NATIVE": "OFF",
        "MINIEX_BUILD_BENCH": "ON",
        "MINIEX_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan"
    },
    {
      "name": "tsan",
      "configurePreset": "tsan"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "release-tap",
      "configurePreset": "release-tap"
    },
    {
      "name": "release-portable",
      "configurePreset": "release-portable"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": false
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "concurrency"
        }
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
